// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Payment: A single payment received on-chain ─────────────────────────────

model Payment {
  id              String   @id @default(cuid())
  paymentId       String   @unique
  merchant        String
  token           String
  amount          String
  blockNumber     Int?
  transactionHash String?
  
  // Payment origin tracking
  source          String   @default("ARC")  // "ARC" (local) or "CCTP" (cross-chain)
  sourceChain     String   @default("Arc")  // Human-readable chain name
  sourceTxHash    String?                    // Original tx on source chain (for CCTP)
  
  // Settlement tracking
  settled         Boolean  @default(false)
  settlementTxHash String?
  settledAt       DateTime?
  batchId         String?
  settlementAmount String?
  settlementFee    String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([merchant])
  @@index([settled])
  @@index([source])
  @@index([createdAt])
}

// ─── Batch: A batch settlement execution ─────────────────────────────────────

model Batch {
  id              String   @id @default(cuid())
  batchId         String   @unique // The bytes32 used on-chain
  merchantCount   Int      // How many merchants in this batch
  totalAmount     String   // Total amount settled
  gasUsed         String   // Gas used for the transaction
  gasSaved        String   // Estimated gas saved vs individual settlements
  transactionHash String
  blockNumber     Int
  
  createdAt       DateTime @default(now())
  
  @@index([createdAt])
}

// ─── MerchantIntent: Cache of merchant intents (optional, for analytics) ─────

model MerchantIntent {
  id                  String   @id @default(cuid())
  merchant            String   @unique
  speed               String   // IMMEDIATE, STANDARD, DEFERRED
  minBatchAmount      String
  maxWaitTimeSeconds  Int
  targetToken         String
  
  updatedAt           DateTime @updatedAt
  
  @@index([merchant])
}


// ─── CCTPTransfer: Tracks cross-chain USDC transfers via CCTP V2 ─────────────

model CCTPTransfer {
  id                  String    @id @default(cuid())
  
  // CCTP identifiers (compound unique key)
  nonce               String
  sourceDomain        Int
  destinationDomain   Int
  
  // Transfer details
  burnToken           String
  amount              String
  depositor           String    // Who burned USDC on the source chain
  mintRecipient       String    // Our CCTPReceiver address (as bytes32)
  
  // Source chain info
  sourceChain         String    // Human-readable chain name
  sourceTxHash        String    // Burn transaction hash
  sourceBlockNumber   Int
  
  // Relay state machine
  // DETECTED → PENDING_ATTESTATION → ATTESTED → MINTING → MINTED → PROCESSING → COMPLETED | FAILED
  status              String    @default("DETECTED")
  
  // Filled during relay
  messageBytes        String?   // Raw CCTP message bytes (for receiveMessage)
  attestation         String?   // Circle's signed attestation
  mintTxHash          String?   // receiveMessage() tx hash on Arc
  processTxHash       String?   // processPayment() tx hash on Arc
  error               String?   // Error message if FAILED
  
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  
  // Compound unique: a nonce is unique per source domain
  @@unique([nonce, sourceDomain], name: "nonce_sourceDomain")
  @@index([status])
  @@index([sourceTxHash])
  @@index([depositor])
  @@index([createdAt])
}